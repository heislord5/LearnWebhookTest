# Private ESPN leagues need the two cookies from a browser session where you are logged in.
# In Chrome: espn.com -> DevTools -> Application -> Cookies -> https://www.espn.com
# Copy the values of espn_s2 and SWID. SWID includes the curly braces.
ESPN_S2=
ESPN_SWID=
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
# Optional. Defaults to the current scoring period from the league.
ESPN_WEEK=
# Optional. Limits "mine" views to this ESPN team id.
ESPN_TEAM_ID=
